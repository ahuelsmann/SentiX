FROM ubuntu:24.04 AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake ninja-build libssl-dev nlohmann-json3-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /source
COPY src/native/ src/native/
RUN cmake -S src/native -B build/native -G Ninja -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build/native --target sentix-native

FROM ubuntu:24.04 AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends libssl3t64 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /source/build/native/sentix-native /usr/local/bin/sentix-native
ENTRYPOINT ["/usr/local/bin/sentix-native"]
