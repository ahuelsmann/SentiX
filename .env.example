# === PostgreSQL ===
POSTGRES_PASSWORD=change_me_strong_password

# === Alpaca (Paper Trading, Basic Plan, einheitlich mit Alpaca CLI) ===
ALPACA_TRADING_ENABLED=false
ALPACA_PAPER_MODE=true
ALPACA_ALLOW_SHORTING=false
ALPACA_API_KEY=PK_YOUR_PAPER_KEY
ALPACA_SECRET_KEY=YOUR_PAPER_SECRET

# === X (Twitter) API v2 (Optional in Phase 1 — leer = graceful skip) ===
X_BEARER_TOKEN=
X_DAILY_POST_CAP=150

# === SEC EDGAR 8-K Filings (Optional in Phase 2 — leer oder "disabled" = graceful skip) ===
SEC_USER_AGENT=
SEC_POLL_INTERVAL_SECONDS=30

# === Earnings- & Makro-Kalender (Optional in Phase 2/3 — leer = graceful skip) ===
FINNHUB_API_KEY=

# === Native ONNX-FinBERT Engine (Phase 2) ===
SENTIX_ENGINE_MODE=auto
SENTIX_MODEL_PATH=/models/finbert-int8.onnx
SENTIX_VOCAB_PATH=/models/vocab.txt
SENTIX_FINBERT_LABELS=positive,negative,neutral
SENTIX_ONNX_INTRA_OP_THREADS=1

# === Decision-Swarm LLM-Routing ===
LLM_FAST_PROVIDER=openai_compatible
LLM_FAST_MODEL=gpt-4o-mini
LLM_FAST_API_KEY=your_key
LLM_JUDGE_PROVIDER=anthropic
LLM_JUDGE_MODEL=claude-sonnet-4-5
LLM_JUDGE_API_KEY=your_key

# === Alerts (Optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
